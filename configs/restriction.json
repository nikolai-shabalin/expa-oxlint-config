{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "rules": {
    "default-case": "warn",
    "no-alert": "warn",
    "no-bitwise": "warn",
    "no-console": "warn",
    "no-div-regex": "warn",
    "no-empty": "warn",
    "no-empty-function": "warn",
    "no-eq-null": "warn",
    "no-iterator": "warn",
    "no-plusplus": "warn",
    "no-proto": "warn",
    "no-regex-spaces": "warn",
    "no-restricted-globals": "warn",
    "no-restricted-imports": "warn",
    "no-undefined": "warn",
    "no-unused-expressions": "warn",
    "no-var": "warn",
    "no-void": "warn",
    "unicode-bom": "warn",
    "extensions": "warn",
    "no-amd": "warn",
    "no-commonjs": "warn",
    "no-cycle": "warn",
    "no-default-export": "warn",
    "no-dynamic-require": "warn",
    "no-webpack-loader-syntax": "warn",
    "unambiguous": "warn",
    "check-access": "warn",
    "empty-tags": "warn",
    "anchor-ambiguous-text": "warn",
    "no-new-require": "warn",
    "bad-bitwise-operator": "warn",
    "no-async-await": "warn",
    "no-barrel-file": "warn",
    "no-const-enum": "warn",
    "no-optional-chaining": "warn",
    "no-rest-spread-properties": "warn",
    "catch-or-return": "warn",
    "spec-only": "warn",
    "button-has-type": "warn",
    "forbid-elements": "warn",
    "jsx-filename-extension": "warn",
    "no-danger": "warn",
    "no-unknown-property": "warn",
    "explicit-function-return-type": "warn",
    "explicit-module-boundary-types": "warn",
    "no-dynamic-delete": "warn",
    "no-empty-object-type": "warn",
    "no-explicit-any": "warn",
    "no-import-type-side-effects": "warn",
    "no-namespace": "warn",
    "no-non-null-asserted-nullish-coalescing": "warn",
    "no-non-null-assertion": "warn",
    "no-require-imports": "warn",
    "no-var-requires": "warn",
    "non-nullable-type-assertion-style": "warn",
    "prefer-literal-enum-member": "warn",
    "promise-function-async": "warn",
    "use-unknown-in-catch-callback-variable": "warn",
    "no-abusive-eslint-disable": "warn",
    "no-anonymous-default-export": "warn",
    "no-array-for-each": "warn",
    "no-array-reduce": "warn",
    "no-document-cookie": "warn",
    "no-length-as-slice-end": "warn",
    "no-magic-array-flat-depth": "warn",
    "no-process-exit": "warn",
    "prefer-modern-math-apis": "warn",
    "prefer-node-protocol": "warn",
    "prefer-number-properties": "warn",
    "no-multiple-slot-args": "warn"
  }
}
