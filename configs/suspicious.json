{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "rules": {
    "block-scoped-var": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-new": "warn",
    "no-unexpected-multiline": "warn",
    "no-unneeded-ternary": "warn",
    "no-useless-concat": "warn",
    "no-useless-constructor": "warn",
    "no-absolute-path": "warn",
    "no-empty-named-blocks": "warn",
    "no-named-as-default": "warn",
    "no-named-as-default-member": "warn",
    "no-self-import": "warn",
    "no-unassigned-import": "warn",
    "no-commented-out-tests": "warn",
    "approx-constant": "warn",
    "misrefactored-assign-op": "warn",
    "no-async-endpoint-handlers": "warn",
    "always-return": "warn",
    "no-promise-in-callback": "warn",
    "iframe-missing-sandbox": "warn",
    "jsx-no-comment-textnodes": "warn",
    "jsx-no-script-url": "warn",
    "no-namespace": "warn",
    "react-in-jsx-scope": "warn",
    "style-prop-object": "warn",
    "no-confusing-non-null-assertion": "warn",
    "no-extraneous-class": "warn",
    "no-unnecessary-boolean-literal-compare": "warn",
    "no-unnecessary-template-expression": "warn",
    "no-unnecessary-type-arguments": "warn",
    "no-unnecessary-type-assertion": "warn",
    "no-unnecessary-type-constraint": "warn",
    "no-unsafe-enum-comparison": "warn",
    "no-unsafe-type-assertion": "warn",
    "consistent-function-scoping": "warn",
    "no-accessor-recursion": "warn",
    "no-array-reverse": "warn",
    "no-instanceof-builtins": "warn",
    "prefer-add-event-listener": "warn",
    "require-post-message-target-origin": "warn"
  }
}
